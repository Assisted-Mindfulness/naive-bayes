{
    "name": "assisted-mindfulness/naive-bayes",
    "description": "A fluent Naive Bayes classifier for PHP and Laravel with normalized arbitrary-precision probabilities.",
    "keywords": [
        "bayes",
        "classification",
        "classifier",
        "laravel",
        "machine-learning",
        "naive-bayes",
        "nlp",
        "probability"
    ],
    "homepage": "https://github.com/Assisted-Mindfulness/naive-bayes",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/Assisted-Mindfulness/naive-bayes/issues",
        "source": "https://github.com/Assisted-Mindfulness/naive-bayes"
    },
    "autoload": {
        "psr-4": {
            "AssistedMindfulness\\NaiveBayes\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Alexandr Chernyaev",
            "email": "bliz48rus@gmail.com",
            "homepage": "https://tabuna.github.io",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "brick/math": "^0.18"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "infection/infection": "^0.31|^0.34",
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5|^12.5|^13.0",
        "rector/rector": "^2.3",
        "symfony/var-dumper": "^7.4|^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "AssistedMindfulness\\NaiveBayes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --debug",
        "format": "pint",
        "format:check": "pint --test",
        "mutation": "infection --threads=max --no-progress",
        "refactor": "rector process --debug",
        "refactor:check": "rector process --dry-run --debug",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "check": [
            "@test",
            "@analyse",
            "@refactor:check",
            "@format:check"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true,
        "lock": false
    }
}
